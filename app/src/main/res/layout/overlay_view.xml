<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/overlayRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/overlay_glass_background"
    android:paddingStart="40dp"
    android:paddingEnd="40dp"
    android:paddingTop="32dp"
    android:paddingBottom="36dp"
    android:elevation="24dp"
    android:minWidth="820dp">

    <!-- Current Time -->
    <TextView
        android:id="@+id/currentTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-light"
        android:textColor="#E6FFFFFF"
        android:textSize="28sp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="10:30 AM" />

    <!-- Period Name -->
    <TextView
        android:id="@+id/periodName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.06"
        android:textColor="#B0BEC5"
        android:textSize="68sp"
        android:textAllCaps="true"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/currentTime"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="SCIENCE" />

    <!-- Remaining Time -->
    <TextView
        android:id="@+id/timeRemainingLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:fontFamily="sans-serif-light"
        android:text="TIME REMAINING"
        android:textColor="#99FFFFFF"
        android:textSize="30sp"
        android:letterSpacing="0.05"
        app:layout_constraintTop_toBottomOf="@id/periodName"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/timeRemainingValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-black"
        android:textColor="#FFFFFFFF"
        android:textSize="72sp"
        app:layout_constraintTop_toBottomOf="@id/timeRemainingLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="05:30" />

    <!-- Elapsed Time -->
    <TextView
        android:id="@+id/timeElapsedLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:fontFamily="sans-serif-light"
        android:text="TIME ELAPSED"
        android:textColor="#99FFFFFF"
        android:textSize="24sp"
        android:letterSpacing="0.12"
        app:layout_constraintTop_toBottomOf="@id/timeRemainingValue"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/timeElapsedValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="sans-serif-bold"
        android:textColor="#F5FFFFFF"
        android:textSize="58sp"
        app:layout_constraintTop_toBottomOf="@id/timeElapsedLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="44:30" />

    <!-- Progress Bar -->
    <ProgressBar
        android:id="@+id/timeProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="18dp"
        android:layout_marginTop="18dp"
        android:progressDrawable="@drawable/custom_progress_bar"
        android:progress="60"
        app:layout_constraintTop_toBottomOf="@id/timeElapsedValue"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
