<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Soft shadow / lift -->
    <item
        android:left="1dp"
        android:top="2dp"
        android:right="1dp"
        android:bottom="0dp">
        <shape>
            <corners android:radius="8dp" />
            <solid android:color="#22000000" />
        </shape>
    </item>

    <!-- Glass surface -->
    <item>
        <shape>
            <!-- Liquid glass light -->
            <gradient
                android:startColor="#66FFFFFF"
                android:endColor="#33FFFFFF"
                android:angle="270" />

            <corners android:radius="8dp" />

            <!-- Inner specular edge -->
            <stroke
                android:width="1dp"
                android:color="#55FFFFFF" />
        </shape>
    </item>

</layer-list>
