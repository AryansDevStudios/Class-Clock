<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Shadow -->
    <item
        android:left="3dp"
        android:top="6dp"
        android:right="3dp"
        android:bottom="0dp">
        <shape>
            <corners android:radius="22dp" />
            <solid android:color="#22000000" />
        </shape>
    </item>

    <!-- Glass -->
    <item>
        <shape>
            <corners android:radius="22dp" />
            <gradient
                android:startColor="#66FFFFFF"
                android:endColor="#33FFFFFF"
                android:angle="270" />
            <stroke
                android:width="1dp"
                android:color="#55FFFFFF" />
        </shape>
    </item>

</layer-list>
